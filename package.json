{
  "name": "mindmap-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local-first mind mapping PWA — a MindManager replacement. Phase 0 spike.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deadcode": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-budget.mjs",
    "gate": "tsc --noEmit && biome check . && knip && vitest run && vite build && node scripts/size-budget.mjs"
  },
  "dependencies": {
    "@mind-elixir/node-menu": "^5.0.1",
    "fast-xml-parser": "^4.5.1",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "mind-elixir": "^5.12.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "knip": "^6.16.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
}
